```env
# Database
DATABASE_URL=""

# AWS S3
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Admin Credentials
ADMIN_NAME=""
ADMIN_PHONE=""
ADMIN_PASSWORD=""
# Optional, but required for "Forgot password" to be able to email a reset
# link. In SES sandbox mode this must also be an SES-verified address.
ADMIN_EMAIL=""

# Required for "Forgot password" to send anything. The SES sender identity
# password reset emails come from. In SES sandbox mode this must be a
# verified identity (verified email, or a verified domain that covers it).
SES_FROM_EMAIL=""

# Public site URL, used to build the sitemap and robots.txt. Set this to the
# real production domain once it's live.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Leave blank until you create a GA4 property — analytics stays
# inactive (no script loaded) until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
```
